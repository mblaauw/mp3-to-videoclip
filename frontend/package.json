{
  "name": "mp3-to-videoclip-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node --test tests/nextStep.test.ts",
    "preview": "vite preview",
    "api:types": "uv run --project .. python ../scripts/dump_openapi.py ../frontend/openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@remotion/player": "4.0.536",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
